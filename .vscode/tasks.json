{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preparar classes (Maven)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/maven.ps1",
        "compile"
      ],
      "linux": {
        "command": "mvn",
        "args": [
          "compile"
        ]
      },
      "osx": {
        "command": "mvn",
        "args": [
          "compile"
        ]
      },
      "problemMatcher": []
    }
  ]
}