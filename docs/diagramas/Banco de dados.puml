@startuml
entity produtor {
 * id : BIGINT <<PK>>
 --
 nome : VARCHAR(120)
 descricao : VARCHAR(1000)
 telefone : VARCHAR(25)
 localizacao : VARCHAR(180)
}
entity produto {
 * id : BIGINT <<PK>>
 --
 * produtor_id : BIGINT <<FK NOT NULL>>
 nome : VARCHAR(120)
 descricao : VARCHAR(1000)
 categoria : VARCHAR(80)
}
entity feira {
 * id : BIGINT <<PK>>
 --
 nome : VARCHAR(120)
 endereco : VARCHAR(200)
 dias : VARCHAR(120)
 horario : VARCHAR(120)
}
entity produtor_feira {
 * produtor_id : BIGINT <<PK,FK>>
 * feira_id : BIGINT <<PK,FK>>
}
produtor ||--o{ produto
produtor ||--o{ produtor_feira
feira ||--o{ produtor_feira
note bottom
Chave composta impede participação duplicada.
Todas as FKs usam ON DELETE CASCADE.
Campos não chave também são NOT NULL.
ItemCatalogo é abstrata: não possui tabela própria.
end note
@enduml
