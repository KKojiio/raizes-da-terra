@startuml
entity produtor {
 * id : BIGINT <<PK>>
 --
 nome : VARCHAR(120)
 descricao : VARCHAR(1000)
 telefone : VARCHAR(25)
 localizacao : VARCHAR(180)
}
entity produto {
 * id : BIGINT <<PK>>
 --
 * produtor_id : BIGINT <<FK NOT NULL>>
 nome : VARCHAR(120)
 descricao : VARCHAR(1000)
 categoria : VARCHAR(80)
}
entity feira {
 * id : BIGINT <<PK>>
 --
 nome : VARCHAR(120)
 endereco : VARCHAR(200)
 dias : VARCHAR(120)
 horario : VARCHAR(120)
}
entity produtor_feira {
 * produtor_id : BIGINT <<PK,FK>>
 * feira_id : BIGINT <<PK,FK>>
}
produtor ||--o{ produto
produtor ||--o{ produtor_feira
feira ||--o{ produtor_feira
entity usuario {
 * id : BIGINT <<PK>>
 --
 nome : VARCHAR(120)
 email : VARCHAR(160) <<UNIQUE>>
 senha_hash : VARCHAR(255)
 tipo : ENUM(ADMINISTRADOR, PRODUTOR)
}
entity administrador {
 * id_usuario : BIGINT <<PK,FK>>
 --
 matricula : VARCHAR(20)
}
usuario ||--o| administrador
note bottom
Chave composta impede participação duplicada.
Todas as FKs usam ON DELETE CASCADE.
Campos não chave também são NOT NULL.
Pessoa é abstrata e ItemCatalogo é interface: não possuem tabelas próprias.
Produtor é gravado em produtor; o administrador usa usuario + administrador.
end note
@enduml
